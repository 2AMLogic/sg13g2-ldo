v {xschem version=3.4.7 file_version=1.3
* ldo_core_cmos5l -- top-level symbol for the SG13CMOS5L LDO core
* (issue #20). Pin order matches the ipin/opin/iopin instance order in
* ldo_core_cmos5l.sch: VIN, VOUT, VSS, VREF, IBIAS -- the SG13G2 branch's
* four-port list with IBIAS appended, so the shared four keep their
* positions. See ldo_core_cmos5l.sch for why IBIAS exists.
}
G {}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
V {}
S {}
E {}
L 4 -80 -80 80 -80 {}
L 4 80 -80 80 80 {}
L 4 80 80 -80 80 {}
L 4 -80 80 -80 -80 {}
B 5 -81.25 -41.25 -78.75 -38.75 {name=VIN dir=inout}
B 5 78.75 -41.25 81.25 -38.75 {name=VOUT dir=inout}
B 5 -1.25 78.75 1.25 81.25 {name=VSS dir=inout}
B 5 -81.25 38.75 -78.75 41.25 {name=VREF dir=in}
B 5 -1.25 -81.25 1.25 -78.75 {name=IBIAS dir=inout}
T {@name} -80 -94 0 0 0.2 0.2 {}
T {@symname} -60 -8 0 0 0.25 0.25 {}
T {VIN} -72 -50 0 0 0.15 0.15 {}
T {VOUT} 40 -50 0 0 0.15 0.15 {}
T {VSS} -14 58 0 0 0.15 0.15 {}
T {VREF} -72 28 0 0 0.15 0.15 {}
T {IBIAS} -18 -70 0 0 0.15 0.15 {}
