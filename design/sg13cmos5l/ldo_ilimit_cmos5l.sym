v {xschem version=3.4.7 file_version=1.3
* ldo_ilimit_cmos5l -- symbol for the SG13CMOS5L current limiter (issue #165,
* DR-0017). Pin order matches the ipin/iopin instance order in
* ldo_ilimit_cmos5l.sch: VIN, VOUT, EAOUT, IBIAS, EN, VSS. The core
* instantiates it as: Xilim VIN VOUT EAOUT IBIAS EN VSS ldo_ilimit_cmos5l.
}
G {}
K {type=subcircuit
format="@name @pinlist @symname"
template="name=x1"
}
V {}
S {}
E {}
L 4 -80 -80 80 -80 {}
L 4 80 -80 80 80 {}
L 4 80 80 -80 80 {}
L 4 -80 80 -80 -80 {}
B 5 -81.25 -41.25 -78.75 -38.75 {name=VIN dir=inout}
B 5 78.75 -41.25 81.25 -38.75 {name=VOUT dir=inout}
B 5 78.75 38.75 81.25 41.25 {name=EAOUT dir=inout}
B 5 38.75 -81.25 41.25 -78.75 {name=IBIAS dir=inout}
B 5 -41.25 78.75 -38.75 81.25 {name=EN dir=in}
B 5 38.75 78.75 41.25 81.25 {name=VSS dir=inout}
T {@name} -80 -94 0 0 0.2 0.2 {}
T {@symname} -60 -8 0 0 0.25 0.25 {}
T {VIN} -72 -50 0 0 0.15 0.15 {}
T {VOUT} 40 -50 0 0 0.15 0.15 {}
T {EAOUT} 34 28 0 0 0.15 0.15 {}
T {IBIAS} 22 -70 0 0 0.15 0.15 {}
T {EN} -50 58 0 0 0.15 0.15 {}
T {VSS} 26 58 0 0 0.15 0.15 {}
