{
  "schema_version": 1,
  "kind": "t1-attestation-inventory",
  "t1_item": 1,
  "description": "SG13CMOS5L design sources (design/sg13cmos5l/) and the three ngspice netlists design/netlist.py exports from them. Each derived netlist's freshness check is `design/netlist.py --design sg13cmos5l --cell <cell> --check`, which re-runs the xschem export against the PDK the environment resolves and byte-compares the result with the committed file -- so a present-but-stale netlist fails. The SG13G2-branch placeholder sources under design/ are NOT attested (signoff/README.md, 'Scope'). Freshness and identity only: NOT a performance, spec-compliance or whole-block T1 claim.",
  "sources": [
    "design/README.md",
    "design/netlist.py",
    "design/sg13cmos5l/ldo_core_cmos5l.sch",
    "design/sg13cmos5l/ldo_core_cmos5l.sym",
    "design/sg13cmos5l/ldo_erramp_cmos5l.sch",
    "design/sg13cmos5l/ldo_erramp_cmos5l.sym",
    "design/sg13cmos5l/ldo_ilimit_cmos5l.sch",
    "design/sg13cmos5l/ldo_ilimit_cmos5l.sym",
    "design/xschemrc"
  ],
  "derived": [
    {
      "path": "design/sg13cmos5l/netlist/ldo_core_cmos5l.spice",
      "generator": "design/netlist.py (xschem netlist -erc, headless)",
      "check": {
        "argv": [
          "python3",
          "design/netlist.py",
          "--design",
          "sg13cmos5l",
          "--cell",
          "ldo_core_cmos5l",
          "--check"
        ],
        "cwd": "."
      }
    },
    {
      "path": "design/sg13cmos5l/netlist/ldo_erramp_cmos5l.spice",
      "generator": "design/netlist.py (xschem netlist -erc, headless)",
      "check": {
        "argv": [
          "python3",
          "design/netlist.py",
          "--design",
          "sg13cmos5l",
          "--cell",
          "ldo_erramp_cmos5l",
          "--check"
        ],
        "cwd": "."
      }
    },
    {
      "path": "design/sg13cmos5l/netlist/ldo_ilimit_cmos5l.spice",
      "generator": "design/netlist.py (xschem netlist -erc, headless)",
      "check": {
        "argv": [
          "python3",
          "design/netlist.py",
          "--design",
          "sg13cmos5l",
          "--cell",
          "ldo_ilimit_cmos5l",
          "--check"
        ],
        "cwd": "."
      }
    }
  ]
