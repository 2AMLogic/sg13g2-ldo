{
 "netlist": "tb.spice",
 "backend": "batch",
 "batch": {
  "runner_version_check": "warn",
  "capacity_wait_s": 3600
 },
 "models": {
  "lib": "corners.lib"
 },
 "analysis": {
  "kind": "ac",
  "args": "dec 20 1 100meg"
 },
 "measurements": [
  {
   "name": "liveness_vout",
   "spice": ".meas ac liveness_vout FIND vm(vout) AT=1",
   "unit": "V"
  }
 ],
 "corners": {
  "process": [
   "mos_ff__res_bcs__cap_typ",
   "mos_ff__res_typ__cap_typ",
   "mos_ff__res_wcs__cap_typ",
   "mos_fs__res_bcs__cap_typ",
   "mos_fs__res_typ__cap_typ",
   "mos_fs__res_wcs__cap_typ",
   "mos_sf__res_bcs__cap_typ",
   "mos_sf__res_typ__cap_typ",
   "mos_sf__res_wcs__cap_typ",
   "mos_ss__res_bcs__cap_typ",
   "mos_ss__res_typ__cap_typ",
   "mos_ss__res_wcs__cap_typ",
   "mos_tt__res_bcs__cap_typ",
   "mos_tt__res_typ__cap_typ",
   "mos_tt__res_wcs__cap_typ"
  ],
  "temperature_c": [
   -40,
   27,
   125
  ]
 },
 "options": {
  "timeout_s": 1800,
  "keep_artifacts": true,
  "waveforms": true,
  "stage_model_inputs": true,
  "osdi_preload": [
   "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/psp103.osdi",
   "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/psp103_nqs.osdi",
   "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/mosvar.osdi",
   "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/r3_cmc.osdi",
   "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/cap_cmomi.osdi",
   "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/cap_cmomf.osdi"
  ]
 }
}
