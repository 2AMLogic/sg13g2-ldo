* sg13g2-ldo -- SG13CMOS5L closed-loop PSRR bench (issue #21).
* Generated from
* sim/ldo-cmos5l-pvt-sweep/testbench/tb_psrr_cmos5l.spice.tmpl by
* sim/ldo-cmos5l-pvt-sweep/run_sweep.sh -- do not edit a generated
* netlist-snapshots/*.spice file directly. Full methodology in
* sim/ldo-cmos5l-pvt-sweep/README.md; this header is a short pointer.
*
* Generated for: corner=@@MOS_SECTION@@ temp=@@TEMP@@C
* PDK: @@PDK@@ @@PDK_ROOT@@ (see sim/pdk-cmos5l.json for the pinned release)
* OSDI models: @@OSDI_DIR@@ (built by sim/tools/build-osdi.sh)
* Design netlist under test (frozen at this repo's git sha in the record):
*   @@DESIGN_NETLIST@@
*
* Closed-loop bench (no flattening/loop-break needed, unlike
* tb_loopgain_cmos5l.spice.tmpl): ldo_core_cmos5l is instantiated whole.
* Vin carries a 1V AC stimulus (dc still 3.30V); Vref's AC component is
* held at 0 so the only AC excitation into the loop is the supply ripple
* under test. PSRR_dB(f) = -20*log10(|v(vout)/v(vin)|) -- reported as a
* positive rejection number (higher = better), the sign convention
* README.md's "Target specification" table's PSRR row assumes.

.lib "@@PDK_ROOT@@/@@PDK@@/libs.tech/ngspice/models/cornerMOShv.lib" @@MOS_SECTION@@
.lib "@@PDK_ROOT@@/@@PDK@@/libs.tech/ngspice/models/cornerRES.lib" @@RES_SECTION@@
.lib "@@PDK_ROOT@@/@@PDK@@/libs.tech/ngspice/models/cornerCAP.lib" @@CAP_SECTION@@

.options temp=@@TEMP@@ tnom=27

.include "@@DESIGN_NETLIST@@"

Vin VIN 0 dc 3.30 ac 1
Vref VREF 0 dc 0.90 ac 0
Ibias IBIAS 0 dc 2u
Iload VOUT 0 dc 0.001
Cout VOUT 0 1u

Xtop VIN VOUT 0 VREF IBIAS ldo_core_cmos5l

.control
pre_osdi @@OSDI_DIR@@/psp103.osdi
pre_osdi @@OSDI_DIR@@/psp103_nqs.osdi
pre_osdi @@OSDI_DIR@@/mosvar.osdi
pre_osdi @@OSDI_DIR@@/r3_cmc.osdi
pre_osdi @@OSDI_DIR@@/cap_cmomi.osdi
pre_osdi @@OSDI_DIR@@/cap_cmomf.osdi

ac dec 20 1 100meg
let psrr_db = -db(v(vout)/v(vin))
wrdata @@AC_CSV@@ psrr_db
.endc
.end
