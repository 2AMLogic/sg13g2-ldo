{
  "netlist": "tb_disabled_leak.spice",
  "backend": "batch",
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  },
  "models": {
    "lib": "enable-corners.lib"
  },
  "analysis": {
    "kind": "dc",
    "args": "Vin 2.00 3.64 0.01"
  },
  "measurements": [
    {
      "name": "ileak_pass_2p97",
      "spice": ".meas dc ileak_pass_2p97 FIND par('i(vclamp)') AT=2.97",
      "unit": "A"
    },
    {
      "name": "isup_2p97",
      "spice": ".meas dc isup_2p97 FIND par('-i(vin)') AT=2.97",
      "unit": "A"
    },
    {
      "name": "eaout_2p97",
      "spice": ".meas dc eaout_2p97 FIND v(xtop.eaout) AT=2.97",
      "unit": "V"
    },
    {
      "name": "vsg_pass_2p97",
      "spice": ".meas dc vsg_pass_2p97 FIND par('v(vin)-v(xtop.eaout)') AT=2.97",
      "unit": "V"
    },
    {
      "name": "vsg_men_2p97",
      "spice": ".meas dc vsg_men_2p97 FIND par('v(vin)-v(en)') AT=2.97",
      "unit": "V"
    },
    {
      "name": "ileak_pass_3p30",
      "spice": ".meas dc ileak_pass_3p30 FIND par('i(vclamp)') AT=3.3",
      "unit": "A"
    },
    {
      "name": "isup_3p30",
      "spice": ".meas dc isup_3p30 FIND par('-i(vin)') AT=3.3",
      "unit": "A"
    },
    {
      "name": "eaout_3p30",
      "spice": ".meas dc eaout_3p30 FIND v(xtop.eaout) AT=3.3",
      "unit": "V"
    },
    {
      "name": "vsg_pass_3p30",
      "spice": ".meas dc vsg_pass_3p30 FIND par('v(vin)-v(xtop.eaout)') AT=3.3",
      "unit": "V"
    },
    {
      "name": "vsg_men_3p30",
      "spice": ".meas dc vsg_men_3p30 FIND par('v(vin)-v(en)') AT=3.3",
      "unit": "V"
    },
    {
      "name": "ileak_pass_3p63",
      "spice": ".meas dc ileak_pass_3p63 FIND par('i(vclamp)') AT=3.63",
      "unit": "A"
    },
    {
      "name": "isup_3p63",
      "spice": ".meas dc isup_3p63 FIND par('-i(vin)') AT=3.63",
      "unit": "A"
    },
    {
      "name": "eaout_3p63",
      "spice": ".meas dc eaout_3p63 FIND v(xtop.eaout) AT=3.63",
      "unit": "V"
    },
    {
      "name": "vsg_pass_3p63",
      "spice": ".meas dc vsg_pass_3p63 FIND par('v(vin)-v(xtop.eaout)') AT=3.63",
      "unit": "V"
    },
    {
      "name": "vsg_men_3p63",
      "spice": ".meas dc vsg_men_3p63 FIND par('v(vin)-v(en)') AT=3.63",
      "unit": "V"
    }
  ],
  "corners": {
    "process": [
      "tt_nom"
    ],
    "temperature_c": [
      27
    ]
  },
  "options": {
    "timeout_s": 180,
    "keep_artifacts": true,
    "stage_model_inputs": true
  }
}
