{
  "netlist": "tb_row2_accuracy.spice",
  "backend": "batch",
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  },
  "models": {
    "lib": "row2-corners.lib"
  },
  "analysis": {
    "kind": "dc",
    "args": "Vin 3.29 3.31 0.01"
  },
  "measurements": [
    {
      "name": "vout_v",
      "spice": ".meas dc vout_v FIND v(vout) AT=3.30",
      "unit": "V",
      "limits": {
        "min": 1.764,
        "max": 1.836
      }
    }
  ],
  "corners": {
    "process": [
      "tt",
      "ss_rbcs",
      "ff_rwcs",
      "sf_rwcs",
      "fs_rbcs"
    ],
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "exclude": [
    {
      "process": "tt",
      "temperature_c": -40
    },
    {
      "process": "tt",
      "temperature_c": 125
    },
    {
      "process": "ss_rbcs",
      "temperature_c": 27
    },
    {
      "process": "ss_rbcs",
      "temperature_c": 125
    },
    {
      "process": "ff_rwcs",
      "temperature_c": -40
    },
    {
      "process": "ff_rwcs",
      "temperature_c": 27
    },
    {
      "process": "sf_rwcs",
      "temperature_c": -40
    },
    {
      "process": "sf_rwcs",
      "temperature_c": 27
    },
    {
      "process": "fs_rbcs",
      "temperature_c": 27
    },
    {
      "process": "fs_rbcs",
      "temperature_c": 125
    }
  ],
  "monte_carlo": {
    "n": 400,
    "seed": 56001,
    "vary": "mismatch",
    "quantiles": [
      0.135,
      2.275,
      50,
      97.725,
      99.865
    ]
  },
  "options": {
    "timeout_s": 120,
    "keep_artifacts": false,
    "stage_model_inputs": true
  },
  "remote": {
    "hosts": 5
  }
}
