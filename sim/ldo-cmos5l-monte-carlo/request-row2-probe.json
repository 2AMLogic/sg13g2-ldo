{
  "netlist": "tb_row2_accuracy.spice",
  "backend": "batch",
  "batch": {
    "runner_version_check": "warn",
    "capacity_wait_s": 1800
  },
  "models": {
    "lib": "row2-corners.lib"
  },
  "analysis": {
    "kind": "dc",
    "args": "Vin 3.29 3.31 0.01"
  },
  "measurements": [
    {
      "name": "vout_v",
      "spice": ".meas dc vout_v FIND v(vout) AT=3.30",
      "unit": "V",
      "limits": {
        "min": 1.764,
        "max": 1.836
      }
    }
  ],
  "corners": {
    "process": [
      "tt_nom"
    ],
    "temperature_c": [
      27
    ],
    "supply_v": {
      "vref": [
        0.9,
        0.93
      ]
    }
  },
  "options": {
    "timeout_s": 120,
    "keep_artifacts": true,
    "stage_model_inputs": true
  }
}
